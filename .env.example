# Copiar este archivo como .env y completar los valores.
# El archivo .env no se versiona.

# PostgreSQL (lo usan docker-compose.yml y el backend)
POSTGRES_USER=expiry_user
POSTGRES_PASSWORD=cambiar-por-una-contraseña
# Opcional, por defecto expiry_control
# POSTGRES_DB=expiry_control

# Clave para firmar los JWT: mínimo 32 caracteres, aleatoria.
# Se puede generar con: openssl rand -hex 48
JWT_SECRET=cambiar-por-una-clave-aleatoria-de-al-menos-32-caracteres

# Perfil: dev (por defecto) o prod. Se define como variable de entorno del sistema,
# no en este archivo: SPRING_PROFILES_ACTIVE=prod
# En prod son obligatorias DB_URL y CORS_ALLOWED_ORIGINS.

# En una base administrada (por ejemplo Azure) la URL debe pedir conexión cifrada:
# DB_URL=jdbc:postgresql://<servidor>.postgres.database.azure.com:5432/<base>?sslmode=require

# Opcionales en dev
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
# DB_URL=jdbc:postgresql://localhost:5433/expiry_control?options=-c%20TimeZone%3DUTC
# JWT_EXPIRATION_MS=3600000
# DB_POOL_MAX_SIZE=5
# DB_POOL_MIN_IDLE=1
